PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
APP_ENV=development
# Public HTTPS origin for a deployed instance; required before production.
PUBLIC_ORIGIN=
# Optional real text tutor for development only; never commit an actual key.
AI_PROVIDER=simulation
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
AI_TEXT_USER_DAILY_LIMIT=10
AI_TEXT_PROJECT_DAILY_LIMIT=100
# Do not enable production until real auth, PostgreSQL, and provider adapters are configured.
